NODE_ENV=production
PORT=10000
mongo_uri=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AI_SERVICE_URL=http://campusconnect-ai:10000
CORS_ORIGINS=https://your-campusconnect.vercel.app
UPLOAD_DIR=/var/data/uploads

# Set these only when running the corresponding seed scripts.
ADMIN_INITIAL_PASSWORD=
COORDINATOR_INITIAL_PASSWORD=
EVENT_COORDINATOR_INITIAL_PASSWORD=
FACULTY_INITIAL_PASSWORD=
STUDENT_INITIAL_PASSWORD=
TPO_INITIAL_PASSWORD=

# Optional email delivery configuration
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=
